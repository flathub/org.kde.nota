                    }
                }
            ]
        },
        {
            "name": "nota",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/maui/nota/3.1.0/nota-3.1.0.tar.xz",
                    "sha256": "3d76d76a8b99f1f65a1141c86ff9384fc6485887ec30cd8fc60b6683b4523d75",
                    "x-checker-data": {
                        "type": "anitya",
